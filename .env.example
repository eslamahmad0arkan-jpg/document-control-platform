# DriveDoc Control — environment configuration
# Copy to `.env` (repo root) and fill in. All values are optional with safe defaults.

# --- App ---
APP_NAME=DriveDoc Control
APP_ENV=development
DEBUG=true

# --- Database ---
# Default: SQLite stored at backend/data/app.db
# For PostgreSQL: postgresql+psycopg2://USER:PASSWORD@localhost:5432/drivedoc
DATABASE_URL=

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# If empty, a key is auto-generated and persisted to backend/data/secret.key (dev only).
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=43200
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# --- Google OAuth (required for real Google login) ---
# Create OAuth client here: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be:  http://localhost:8000/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/callback
GOOGLE_SCOPES=openid email profile https://www.googleapis.com/auth/drive

# --- Monitoring / Sync ---
MONITOR_ENABLED=true
SYNC_INTERVAL_SECONDS=60
SYNC_RETRY_BASE_SECONDS=2
SYNC_MAX_BACKOFF_SECONDS=300
SYNC_DELAY_BETWEEN_REQUESTS_MS=50

# --- Optional: public HTTPS base URL for Google Drive push notifications ---
# Google requires a publicly reachable HTTPS endpoint. The monitor still works
# without it using polling; leaving it empty disables push watch channels.
WEBHOOK_BASE_URL=